# A package that is published does not pin its dependencies.
pubspec.lock

# The example depends on a published version of this package, which is the
# thing it demonstrates. Pointing it at a local checkout instead is a private
# convenience, and CI writes one of these for itself, so it stays out of git.
example/pubspec_overrides.yaml
